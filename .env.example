# Copy to .env and fill in. The .env file is gitignored — secrets never land in git.

# Your Kasera Pay API key (Dashboard -> Developer -> API keys). Starts with kp_live_
# It stays on the server: the browser never sees it.
KASERA_API_KEY=

# Where the Kasera Pay developer API lives. The developer API is served at
# <base>/v1/... — for the local dev stack that base is the gateway root.
KASERA_API_BASE=http://localhost:8888

# Port this demo shop listens on.
PORT=3300

# Webhook signing secret (Dashboard -> Developer -> Webhook). Starts with whsec_
# Only needed for the webhook case; leave empty otherwise.
WEBHOOK_SECRET=

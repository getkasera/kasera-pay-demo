# Copy to .env and fill in. The .env file is gitignored — secrets never land in git.

# Your Kasera Pay API key (Dashboard -> Developer -> API keys). Starts with kp_live_
# It stays on the server: the browser never sees it.
KASERA_API_KEY=

# Where the Kasera Pay developer API lives. The developer API is served at
# <base>/v1/... — for the local dev stack that base is the gateway root.
KASERA_API_BASE=http://localhost:8888

# Case 4 (subscription): a SANDBOX key, kp_test_... (Dashboard -> Developer ->
# API keys, Sandbox). Only a sandbox subscription can have its clock advanced.
# Falls back to KASERA_API_KEY when empty.
KASERA_TEST_API_KEY=

# Case 4: the sandbox endpoint's secret, when the sandbox key's merchant has
# its own webhook endpoint (Dashboard -> Developer -> Webhook, Sandbox).
# Optional; /webhook accepts deliveries signed with either secret.
WEBHOOK_TEST_SECRET=

# Port this demo shop listens on.
PORT=3300

# Webhook signing secret (Dashboard -> Developer -> Webhook). Starts with whsec_
# Only needed for the webhook case; leave empty otherwise.
# Local dev stack: registration refuses localhost URLs, so invent any value
# here — scripts/simulate-paid.sh signs its deliveries with the same value.
WEBHOOK_SECRET=
